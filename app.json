{
  "expo": {
    "name": "Saga Quest",
    "slug": "saga-quest",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sagaquest",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0a12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xcelim.repogames",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0a12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Saga Quest usa la cámara para escanear el código de barras de tus juegos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Saga Quest usa tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": "Saga Quest usa la cámara para escanear el código de barras de tus juegos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7b2ff7"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/audiowide/400Regular/Audiowide_400Regular.ttf",
            "node_modules/@expo-google-fonts/baloo-2/700Bold/Baloo2_700Bold.ttf",
            "node_modules/@expo-google-fonts/chakra-petch/400Regular/ChakraPetch_400Regular.ttf",
            "node_modules/@expo-google-fonts/chakra-petch/700Bold/ChakraPetch_700Bold.ttf",
            "node_modules/@expo-google-fonts/chakra-petch/700Bold_Italic/ChakraPetch_700Bold_Italic.ttf",
            "node_modules/@expo-google-fonts/cinzel/700Bold/Cinzel_700Bold.ttf",
            "node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/lato/400Regular/Lato_400Regular.ttf",
            "node_modules/@expo-google-fonts/lato/700Bold/Lato_700Bold.ttf",
            "node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
            "node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "node_modules/@expo-google-fonts/orbitron/700Bold/Orbitron_700Bold.ttf",
            "node_modules/@expo-google-fonts/press-start-2p/400Regular/PressStart2P_400Regular.ttf",
            "node_modules/@expo-google-fonts/rajdhani/500Medium/Rajdhani_500Medium.ttf",
            "node_modules/@expo-google-fonts/rajdhani/700Bold/Rajdhani_700Bold.ttf",
            "node_modules/@expo-google-fonts/vt323/400Regular/VT323_400Regular.ttf",
            "node_modules/@expo-google-fonts/pirata-one/400Regular/PirataOne_400Regular.ttf",
            "node_modules/@expo-google-fonts/cormorant-garamond/500Medium/CormorantGaramond_500Medium.ttf",
            "node_modules/@expo-google-fonts/cormorant-garamond/700Bold/CormorantGaramond_700Bold.ttf",
            "node_modules/@expo-google-fonts/cormorant-garamond/700Bold_Italic/CormorantGaramond_700Bold_Italic.ttf",
            "node_modules/@expo-google-fonts/special-elite/400Regular/SpecialElite_400Regular.ttf",
            "node_modules/@expo-google-fonts/creepster/400Regular/Creepster_400Regular.ttf",
            "node_modules/@expo-google-fonts/bangers/400Regular/Bangers_400Regular.ttf",
            "node_modules/@expo-google-fonts/permanent-marker/400Regular/PermanentMarker_400Regular.ttf",
            "node_modules/@expo-google-fonts/bungee/400Regular/Bungee_400Regular.ttf",
            "node_modules/@expo-google-fonts/black-ops-one/400Regular/BlackOpsOne_400Regular.ttf",
            "node_modules/@expo-google-fonts/uncial-antiqua/400Regular/UncialAntiqua_400Regular.ttf",
            "node_modules/@expo-google-fonts/zen-dots/400Regular/ZenDots_400Regular.ttf",
            "node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf",
            "node_modules/@expo-google-fonts/metal-mania/400Regular/MetalMania_400Regular.ttf",
            "node_modules/@expo-google-fonts/russo-one/400Regular/RussoOne_400Regular.ttf",
            "node_modules/@expo-google-fonts/share-tech-mono/400Regular/ShareTechMono_400Regular.ttf",
            "node_modules/@expo-google-fonts/quicksand/500Medium/Quicksand_500Medium.ttf",
            "node_modules/@expo-google-fonts/quicksand/700Bold/Quicksand_700Bold.ttf",
            "node_modules/@expo-google-fonts/playfair-display/700Bold/PlayfairDisplay_700Bold.ttf",
            "node_modules/@expo-google-fonts/playfair-display/700Bold_Italic/PlayfairDisplay_700Bold_Italic.ttf",
            "node_modules/@expo-google-fonts/righteous/400Regular/Righteous_400Regular.ttf",
            "node_modules/@expo-google-fonts/pixelify-sans/400Regular/PixelifySans_400Regular.ttf",
            "node_modules/@expo-google-fonts/pixelify-sans/700Bold/PixelifySans_700Bold.ttf",
            "node_modules/@expo-google-fonts/shojumaru/400Regular/Shojumaru_400Regular.ttf",
            "node_modules/@expo-google-fonts/comfortaa/500Medium/Comfortaa_500Medium.ttf",
            "node_modules/@expo-google-fonts/comfortaa/700Bold/Comfortaa_700Bold.ttf",
            "node_modules/@expo-google-fonts/exo-2/400Regular/Exo2_400Regular.ttf",
            "node_modules/@expo-google-fonts/exo-2/700Bold/Exo2_700Bold.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-mono/400Regular/IBMPlexMono_400Regular.ttf",
            "node_modules/@expo-google-fonts/ibm-plex-mono/700Bold/IBMPlexMono_700Bold.ttf",
            "node_modules/@expo-google-fonts/silkscreen/400Regular/Silkscreen_400Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
